{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/keepwarm", "schedule": "0 6 * * *" }
  ]
}
